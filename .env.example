# Root of the Bubble Data API (no trailing slash).
# Live:       https://SEU_APP.bubbleapps.io/api/1.1/obj
# Test:       https://SEU_APP.bubbleapps.io/version-test/api/1.1/obj
# Domínio próprio: https://seudominio.com/api/1.1/obj
BUBBLE_BASE_URL=https://SEU_APP.bubbleapps.io/api/1.1/obj

# Settings > API > API Tokens no editor Bubble.
# A URL acima pode apontar para qualquer uma das versões: o parâmetro
# versao=live|test (--versao no terminal) deriva a outra sozinho.
BUBBLE_TOKEN=

# Só se o app tiver token separado para a versão de desenvolvimento.
# Vazio: a versao=test usa o BUBBLE_TOKEN acima.
BUBBLE_TOKEN_TEST=

# Chave desta API: toda chamada precisa mandar no header X-API-Key.
# Gere uma com: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# Se ficar vazio, a API fica aberta a quem alcançar a porta.
API_KEY=

# Validade da cópia local das tabelas, em segundos. 0 desliga o cache.
CACHE_TTL=900

# Páginas buscadas em paralelo (100 registros cada). Medido: acima de 16 o
# Bubble não responde mais rápido.
BUBBLE_CONCURRENCY=16

PORT=8080
